
"use strict";

const { EcomDriver } = require("../drivers/ecom");

/*
|--------------------------------------------------------------------------
| Verified ECOM E08EP PON ports
|--------------------------------------------------------------------------
| 0/1/1 - 0/1/4 = first 4 ports
| 0/2/1 - 0/2/4 = next 4 ports
*/

const PON_PORTS = [
    "0/1/1",
    "0/1/2",
    "0/1/3",
    "0/1/4",
    "0/2/1",
    "0/2/2",
    "0/2/3",
    "0/2/4"
];

const DDM_FIELDS = ["temp", "voltage", "bias", "tx", "rx"];

function cleanOutput(output) {
    return String(output || "")
        .replace(/\x1b\[[0-?]*[ -/]*[@-~]/g, "")
        .replace(/\r/g, "")
        .trim();
}

function parseValue(text, labels) {
    const lines = cleanOutput(text).split("\n");

    for (const line of lines) {
        for (const label of labels) {
            const regex = new RegExp(
                "^\\s*" + label +
                "\\s*(?:\\([^)]*\\))?\\s*[:=]?\\s*" +
                "([+-]?\\d+(?:\\.\\d+)?)",
                "i"
            );

            const match = line.match(regex);

            if (match) {
                const value = Number(match[1]);

                if (Number.isFinite(value)) {
                    return value;
                }
            }
        }
    }

    return null;
}

function parseDdm(output, id) {
    const text = cleanOutput(output);

    return {
        id,

        temp: parseValue(text, [
            "Temperature",
            "Temp"
        ]),

        voltage: parseValue(text, [
            "Voltage",
            "Volt"
        ]),

        bias: parseValue(text, [
            "Bias\\s*Current",
            "Bias",
            "Laser\\s*Current"
        ]),

        tx: parseValue(text, [
            "TX\\s*Power",
            "Transmit\\s*Power",
            "TX"
        ]),

        rx: parseValue(text, [
            "RX\\s*Power",
            "Receive\\s*Power",
            "RX"
        ])
    };
}

function getPonPorts(olt) {
    const configuredCount = Number(olt.pon_ports);

    const isEightPortEcom =
        Number(olt.id) === 45 ||
        /E08EP|Ecom\s*8s/i.test(
            `${olt.model || ""} ${olt.name || ""}`
        );

    const count = Number.isInteger(configuredCount) &&
        configuredCount > 0
        ? Math.min(configuredCount, PON_PORTS.length)
        : (isEightPortEcom ? 8 : 4);

    return PON_PORTS.slice(0, count);
}

function isSupportedEcom(olt) {
    const vendor = String(olt.vendor || "")
        .trim()
        .toLowerCase();

    const identity = `${olt.model || ""} ${olt.name || ""}`;

    return vendor === "ecom" &&
        (
            Number(olt.id) === 45 ||
            /E08EP/i.test(identity) ||
            /Ecom\s*8s/i.test(identity)
        );
}

function unavailablePort(id, status = "unavailable") {
    return {
        id,
        temp: null,
        voltage: null,
        bias: null,
        tx: null,
        rx: null,
        status,
        missing_fields: [...DDM_FIELDS]
    };
}

async function readLiveDdm(olt) {
    const ponPorts = getPonPorts(olt);

    /*
     * OLT ID 43 is registered as CData, not ECOM E08EP.
     * Keep its actual 4-port layout; do not send ECOM commands.
     */
    if (!isSupportedEcom(olt)) {
        return {
            ports: ponPorts.map(id => unavailablePort(id)),
            warnings: [
                `OLT ${olt.id}: live DDM is not enabled for vendor/model ` +
                `${olt.vendor || "unknown"}/${olt.model || "unknown"}.`
            ]
        };
    }

    const driver = new EcomDriver({
        id: olt.id,
        olt_id: olt.id,
        company_id: olt.company_id,

        vendor: olt.vendor,
        name: olt.name,
        model: olt.model,

        ip: olt.ip,
        host: olt.ip,
        address: olt.ip,

        port: Number(olt.port) || 23,
        username: olt.username,
        user: olt.username,
        password: olt.password,

        timeout: 12000
    });

    const ports = [];
    const warnings = [];

    try {
        /*
         * Match the successful ecom-probe.js sequence.
         */
        await driver.connect();
        await driver.detectModel();
        await driver.enterConfig();

        for (const id of ponPorts) {
            try {
                const output = await driver.command(
                    `show port ddm-info epon ${id}`,
                    12000
                );

                const result = parseDdm(output, id);

                const missing = DDM_FIELDS.filter(
                    field => result[field] === null
                );

                result.status = missing.length === 0
                    ? "ok"
                    : missing.length === DDM_FIELDS.length
                        ? "unavailable"
                        : "partial";

                result.missing_fields = missing;

                ports.push(result);

                if (missing.length) {
                    warnings.push(
                        `${id}: missing DDM fields: ${missing.join(", ")}`
                    );
                }
            } catch (error) {
                ports.push({
                    ...unavailablePort(id, "error"),
                    error: String(
                        error.message || "DDM query failed"
                    ).slice(0, 150)
                });

                warnings.push(`${id}: DDM query failed`);
            }
        }
    } catch (error) {
        warnings.push(
            `OLT ${olt.id}: ${String(
                error.message || "ECOM connection failed"
            ).slice(0, 200)}`
        );

        for (const id of ponPorts) {
            if (!ports.some(port => port.id === id)) {
                ports.push(unavailablePort(id, "error"));
            }
        }
    } finally {
        try {
            if (typeof driver.disconnect === "function") {
                await driver.disconnect();
            }
        } catch (_) {
            // Preserve the original DDM result.
        }
    }

    return {
        ports,
        warnings
    };
}

module.exports = {
    readLiveDdm,
    parseDdm,
    PON_PORTS
};
